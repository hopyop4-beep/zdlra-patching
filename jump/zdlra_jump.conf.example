# Settings for the jump server (OMS) scripts: oem_blackout.sh and zdlra_patch_run.sh.
# Copy to zdlra_jump.conf (not committed) and edit. This file is sourced by bash.

# --- Enterprise Manager -----------------------------------------------------
EMCLI="emcli"                       # full path if emcli is not on PATH
EM_USER=""                          # set to log in when emcli is not logged in (prompts for the password)

# Must be one of the reasons from: emcli get_blackout_reasons
BLACKOUT_REASON="<reason from emcli get_blackout_reasons>"

# Safety net: the blackout ends by itself after this many hours. -1 = no end time.
BLACKOUT_HOURS=12
# 1 = also black out the targets that belong to the listed targets (-propagate_targets)
BLACKOUT_PROPAGATE=1

# Targets to black out per appliance, as EM "name:type" pairs separated by ";".
# Find the names and types with: ./oem_blackout.sh targets -z <appliance>
# (Assign entries one by one; the scripts declare these lists themselves.)
BLACKOUT_TARGETS[zdlra01]="<target name>:<target type>;<host name>:host"

# --- OEM backup jobs ----------------------------------------------------------
# sr_jobs_new.ksh suspends (-a s) and resumes (-a r) the OEM backup jobs of one
# appliance: sr_jobs_new.ksh -z <zdlra db> -a <s|r> [ -t <I1|ARC> ]
# The commands run in OEM_JOBS_DIR. In the commands, {jobs_db} is replaced with the
# appliance's name for that script (OEM_JOBS_DB below) and {zdlra} with the appliance
# name. A command must exit 0 on success. Leave a command empty to skip that step (a
# warning is logged).
OEM_JOBS_DIR="/odb/oem01/swlib/softwarelibrary/automation/ZDLRA_Automation/ZDLRA_Suspend_Resume_Jobs"
OEM_JOBS_SUSPEND_CMD=(./sr_jobs_new.ksh -z {jobs_db} -a s)
OEM_JOBS_RESUME_CMD=(./sr_jobs_new.ksh -z {jobs_db} -a r)

# Per appliance: its zdlra db value for sr_jobs_new.ksh, one of GF1 GF2 CPGF0NP QAMBL
# CPGF1 CPGF2 CP2GF0NP CP2GF1 CP2GF2 CP3GF1 CP3GF2, or the new values RAGF1 RAGF2
# RA1GF0NP RAGF1NP RA1GF1 RA1GF2 RA2GF0NP RA2GF1 RA2GF2 RA3GF1 RA3GF2.
# A run stops before it starts if its appliance is not listed here.
OEM_JOBS_DB[zdlra01]="RA1GF2"

# --- Appliances -------------------------------------------------------------
# Compute node that runs zdlra_patch.sh, per appliance. If an appliance is not
# listed, the first node in ../staging/appliances.conf is used, then the
# appliance name itself.
PATCH_NODE[zdlra01]="zdlra01db01"

SSH_USER="root"

# Where zdlra_patch.sh and its config live on the compute node.
REMOTE_SCRIPT="/root/zdlra-patching/zdlra_patch.sh"
REMOTE_CONFIG="/root/zdlra-patching/zdlra_patch.conf"

# Seconds between status checks while the patch runs in the background.
POLL_SECONDS=60

# --- Compute nodes ("compute" in the phase list, run from here) --------------
# Paths are on the compute nodes; each node has its own staged copy.
NODE_STAGED_RECORD="/radump/patches/ZDLRA_STAGED.txt"
COMPUTE_TMP_DIR="/radump/patches/tmp"          # the unzipped db_server_patch
COMPUTE_FILES_DIR="/radump/patches/patches"    # the computepatch (iso repo)
COMPUTE_WORK_DIR="/radump/zdlra_compute"       # per run: db_nodes files, logs, exit status
COMPUTE_WARN_MINUTES=240                       # warning only; patchmgr is never stopped
COMPUTE_POLL_SECONDS=60
# SUCCESS WITH WARNING(S) carries on (warnings are listed): allowed for now because
# the prechecks were already reviewed; to revisit. 1 = stop for review instead.
COMPUTE_PAUSE_ON_WARNINGS=0
