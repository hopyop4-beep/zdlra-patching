# Optional settings for zdlra_stage.sh. Copy to zdlra_stage.conf (not committed)
# and edit. This file is sourced by bash; every value below is the built-in default.

# On each node the archive is copied to /radump/patches.zip and unzipped in /radump
# (its patches/ top folder becomes /radump/patches/).
REMOTE_ARCHIVE_NAME="patches.zip"

# What to do when a node already has an older patches.zip or /radump/patches/:
#   backup     keep the oldest older version as <name>.<date>.bak (default); once a
#              backup exists, later older versions are replaced without another
#   overwrite  replace it
OLD_VERSION_ACTION="backup"

# Layout of the unzipped folder: patch files in patches/, the conf file in
# conf/patch.conf_<SR> (exactly one).
PATCHES_SUBDIR="patches"
CONF_SUBDIR="conf"
CONF_GLOB="patch.conf_*"

# Settings in the conf file that are rewritten for each appliance.
COMPONENT_VARS=(COMPUTE_NODE COMPUTE_NODE_01 CELL_NODE CELL_PATCH_LAUNCH_NODE
                SWITCH_TYPE SWITCHES IB_SWITCHES RA_DATABASE)

# Group files on the appliance's first compute node, one host name per line. If one
# is missing or empty, the script pauses and asks you to create it.
DBS_GROUP_FILE="/root/dbs_group"        # -> COMPUTE_NODE; first line -> COMPUTE_NODE_01, CELL_PATCH_LAUNCH_NODE
CELL_GROUP_FILE="/root/cell_group"      # -> CELL_NODE
SWITCH_GROUP_FILE="/root/switch_group"  # -> SWITCHES and IB_SWITCHES (RoCE switches on a RoCE rack)
                                        # TODO(site): confirm this file name

# How each value is found: a command run on the first compute node; output lines
# are joined with commas. The defaults read the group files above. To change one,
# assign that entry (the script declares the list and fills in the rest), e.g.:
#   COMPONENT_CMDS[RA_DATABASE]='su - oracle -c "srvctl config database" | head -1'
# RA_DATABASE defaults to the database's pmon process (ora_pmon_<db><n>) with the
# instance number cut off. TODO(site): the default for SWITCH_TYPE (network
# interface names: re* = roce, ib* = IB) is still a guess.
# components/<appliance>.conf overrides any value.
COMPONENTS_DIR="$(dirname "${BASH_SOURCE[0]}")/components"

# Settings that name patch files (comma-separated); each file must be in patches/.
# TODO(site): confirm the setting names (FILSE_YUM as written?).
FILE_VARS_RE='^(FILES?_[A-Z0-9_]+|FILSE_[A-Z0-9_]+|STAGE_FILE|FRAMEWORK_FILE)$'

# Record written in the unzipped folder on each node (read by zdlra_patch.sh).
STAGED_RECORD_NAME="ZDLRA_STAGED.txt"
