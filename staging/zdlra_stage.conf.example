# Settings for the place step of zdlra_stage.sh. Copy to zdlra_stage.conf (not
# committed) and edit. This file is sourced by bash.
#
# On each node the archive is copied to /radump/patches.zip and unzipped in /radump
# (a zip with a patches/ top folder gives /radump/patches/). Change with -r/-d or
# REMOTE_ARCHIVE_NAME if that ever differs.
REMOTE_ARCHIVE_NAME="patches.zip"

# What to do when a node already has an older patches.zip or unzipped folder:
#   backup     rename it to <name>.<date>.bak (default)
#   overwrite  replace it
OLD_VERSION_ACTION="backup"

# TODO(site): the values below are placeholders until the real directories and
# precheck settings are confirmed.

# Where the patch files go on each compute node, and which files in the archive
# count as patch files.
PATCH_TARGET_DIR="/radump/ra_patches"
PATCH_FILES_GLOB="*.zip"

# The precheck folder inside the archive, and where it goes on each node.
PRECHECK_SRC_SUBDIR="precheck"
PRECHECK_TARGET_DIR="/radump/ra_precheck"

# The precheck's config file (inside PRECHECK_TARGET_DIR), and the KEY=VALUE lines
# to set in it. An existing KEY= line is replaced; a missing one is added. The
# original is kept as <file>.orig. {patch_dir} and {precheck_dir} are replaced
# with the two directories above.
PRECHECK_CONF_FILE="precheck.conf"
PRECHECK_CONF_SETTINGS=(
    "PATCH_DIR={patch_dir}"
)

# Record written in PATCH_TARGET_DIR on each node once staging succeeds. Set
# STAGED_RECORD in zdlra_patch.conf to the same path.
STAGED_RECORD_NAME="ZDLRA_STAGED.txt"
