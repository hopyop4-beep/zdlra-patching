# Copy to zdlra_patch.conf and edit. This file is sourced by bash.
# Do not commit your real zdlra_patch.conf (it is in .gitignore).

RACLI="/opt/oracle.RecoveryAppliance/bin/racli"

# "patch" for a bundle patch, "upgrade" for a release upgrade
PATCH_ACTION="patch"

# Full path to the patch bundle zip downloaded from My Oracle Support
PATCH_ZIP="/radump/patches/<bundle>.zip"

PATCH_STAGE_DIR="/radump/zdlra_patch_stage"
WORK_DIR="/radump/zdlra_patch_runs"
MIN_FREE_GB=50
REQUIRED_USER="root"

# External precheck script (download it yourself; it is not part of this repo).
# The precheck phase fails if the script exits non-zero, times out, or prints
# a line matching PRECHECK_FAIL_PATTERN.
PRECHECK_SCRIPT="/root/zdlra/precheck/<precheck-script>"
PRECHECK_ARGS=()                     # e.g. PRECHECK_ARGS=(--option value)
PRECHECK_TIMEOUT=3600
PRECHECK_FAIL_PATTERN=""             # e.g. PRECHECK_FAIL_PATTERN='^(FAIL|CRITICAL)'
PRECHECK_REQUIRED=1
POSTCHECK_RERUN_PRECHECK=1
