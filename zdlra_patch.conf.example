# Copy to zdlra_patch.conf and edit. This file is sourced by bash.
# Do not commit your real zdlra_patch.conf (it is in .gitignore).

RACLI="/opt/oracle.RecoveryAppliance/bin/racli"

# Record that staging/zdlra_stage.sh writes once the patches and the precheck are
# in place. The precheck phase stops if it is missing, and the approval covers the
# archive it names. It is written in the unzipped folder, /radump/patches.
STAGED_RECORD="/radump/patches/ZDLRA_STAGED.txt"

WORK_DIR="/radump/zdlra_patch_runs"
MIN_FREE_GB=50                       # free space needed in WORK_DIR's filesystem
REQUIRED_USER="root"

# External precheck script (download it yourself; it is not part of this repo).
# Failures are read from the summary at the end of its output:
#   FAILURE SUMMARY
#   ***********************************
#   <date> [FAIL] <failure name>
#   <date> [WARN] <warning name>
# The phase fails on any failure that is not waived, on a timeout, or on a
# non-zero exit code with no summary. Warnings are logged but do not stop the
# run unless PRECHECK_FAIL_ON_WARN=1.
# Oracle's precheck, run as ./precheck -srnumber=<SR> from its own folder.
# In PRECHECK_ARGS, {sr_number} is SR_NUMBER= from the conf file staging set up
# (/radump/patches/conf/patch.conf_<SR>), and {patch_conf} is that file's path.
PRECHECK_SCRIPT="/radump/patches/bin/precheck"
PRECHECK_ARGS=(-srnumber={sr_number})
PRECHECK_CWD=""                      # empty = run from the script's own folder
# Added for the actual patching event (a run with --execute), not for dry runs:
PRECHECK_EVENT_ARGS=(-recheck_all)
PRECHECK_TIMEOUT=3600
PRECHECK_SUMMARY_HEADER="FAILURE SUMMARY"
PRECHECK_FAIL_PATTERN='\[FAIL\]'
PRECHECK_WARN_PATTERN='\[WARN\]'
PRECHECK_FAIL_ON_WARN=0              # 1 = warnings stop the run too (waivers apply)
# Known, accepted failures. Each entry matches part of a failure name.
# Waived failures are logged as warnings and do not stop the run.
PRECHECK_WAIVERS=(
#   "failure name you have reviewed and accepted"
)
PRECHECK_REQUIRED=1

# After the precheck, the operator must type APPROVE. --yes does not skip this.
# quiesce, the ra_* phases and cells refuse to run without an approval for the same run that is
# younger than PRECHECK_APPROVAL_MAX_AGE_HOURS and matches the results reviewed.
PRECHECK_REQUIRE_APPROVAL=1
PRECHECK_APPROVAL_MAX_AGE_HOURS=24
POSTCHECK_RERUN_PRECHECK=1

# --- RA software upgrade (ra_preinstall, ra_alter, ra_update) ----------------
# Each racli step runs in a session of its own and is never stopped by the script;
# past its WARN minutes a warning is logged. In the arguments, {ra_release} is the
# ZDLRA software zip from the staged record (ra_release=), and {gold_images_path} is
# RA_GOLD_IMAGES_PATH. The precheck rolls back what ra_preinstall installs, so
# ra_preinstall always runs after it.
RA_PREINSTALL_ARGS=(run preinstall --zdlra_release_file={ra_release})
RA_PREINSTALL_SUCCESS="End: ra_preinstall post cleanup"
RA_PREINSTALL_FAIL_RE='(CHECK|HOST):.*FAIL'     # any such line in the output fails the step
RA_PREINSTALL_DONE_FILE="/root/.ra_preinstall.install"   # must be written by this run
RA_PREINSTALL_WARN_MINUTES=60
# The precheck moves the gold images here; ra_alter checks both are present first.
RA_GOLD_IMAGES_PATH="/radump/"
RA_ALTER_ARGS=(alter appliance --online_updates --gold_images_path={gold_images_path})
RA_ALTER_SUCCESS="End: Alter Appliance"
RA_ALTER_WARN_MINUTES=60
RA_UPDATE_ARGS=(update appliance --ignore_incidents)    # always --ignore_incidents
RA_UPDATE_SUCCESS="End: Patch Recovery Appliance - Step [Patch]"
RA_UPDATE_WARN_MINUTES=240

# --- Storage cells (cells phase) --------------------------------------------
# Runs from the first compute node in the folder the cell patch (FILES_CELL) unzipped
# to under /radump/patches/tmp; the folder's name is read from the zip.
CELL_GROUP_FILE="/root/cell_group"
CELL_PREP_STEPS=(-patch_check_prereq -reset_force -cleanup)   # before -patch, in order
CELL_PATCH_EXTRA_ARGS=()             # none needed (-ignore_alerts is not used); e.g. (-smtp_from ...)
# patchmgr runs in a session of its own and is never stopped by the script (an
# interrupted patchmgr session can cause major problems). Past this long, the script
# only logs a warning and keeps waiting.
CELL_PATCH_WARN_MINUTES=360          # per patchmgr command; about 2 hours for 17 cells

# --- RoCE switches (switches phase) -----------------------------------------
# Runs on the first compute node, in the folder the switch patch (FILES_SWITCH)
# unzipped to under /radump/patches/tmp (e.g. patch_switch_24.1.14.0.0.250706). Only
# RoCE switches: if SWITCH_TYPE in the conf file is not roce, the phase warns and skips.
SWITCH_GROUP_FILE="/root/switch_group"          # the RoCE switches, one per line
SWITCH_PATCH_TMP_DIR="/radump/patches/tmp"
SWITCH_PATCH_FILES_DIR="/radump/patches/patches"
SWITCH_PRECHECK_ARGS=(--upgrade --roceswitch-precheck)   # about 12 minutes in one sample
SWITCH_UPGRADE_ARGS=(--upgrade)
# patchmgr is never stopped by this script; past this long a warning is logged.
SWITCH_PATCH_WARN_MINUTES=180
# After the upgrade, each switch's version must contain TARGET_SWITCH_VERSION from the
# patch conf file (patch.conf_<SR>). This prints a switch's version; {switch} is its
# name. A switch that cannot be read gives a warning; one on another version fails.
SWITCH_VERSION_CMD=(ssh -o BatchMode=yes -o ConnectTimeout=15 admin@{switch} "show version")

# --- Replication and incoming backups (quiesce / resume phases) -------------
# SQL runs with sqlplus as the raAutomation account. For now the password is in this
# file: zdlra_patch.conf is not in git, and the script warns unless it is chmod 600.
# The connect string goes to sqlplus on stdin, so it never shows in the process list
# or the log. If the password has special characters, quote it: raAutomation/"p@ss".
# Later this can be a wallet alias instead, such as "/@raAutomation".
SQLPLUS="sqlplus"
RA_SQL_CONNECT="raAutomation/<password>"

# While any of these is empty, quiesce is skipped in a dry run and a real run stops
# before patching (unless QUIESCE_ALLOW_UNCONFIGURED=1).
#   REPLICATION_SERVERS_SQL  prints the replication to pause, one remote_ra_dbname per
#                            line: running servers whose role is upstream or paired
#   REPLICATION_STATUS_SQL   shown in the precheck review (read only): every server
#                            with its state and role
#   REPLICATION_PAUSE_SQL    statement run for each of them; {server} is the name
#   REPLICATION_RESUME_SQL   statement run for each one this run paused
#   ACTIVE_BACKUPS_SQL       prints one number: incoming backups still running
#                            (active RMAN sessions in gv$session, by program or module)
#   ACTIVE_BACKUPS_LIST_SQL  optional: those sessions, one per line, shown in the
#                            precheck review and when the wait gives up
REPLICATION_SERVERS_SQL="select remote_ra_dbname from ra_replication_pair where upper(replication_server_state) = 'RUNNING' and upper(replication_server_role) in ('UPSTREAM','PAIRED');"
REPLICATION_STATUS_SQL="select remote_ra_dbname || '  state=' || replication_server_state || '  role=' || replication_server_role from ra_replication_pair;"
# Pause/resume each one by its remote_ra_dbname.
REPLICATION_PAUSE_SQL="begin dbms_ra.pause_replication_server(replication_server_name => '{server}'); end;"
REPLICATION_RESUME_SQL="begin dbms_ra.resume_replication_server(replication_server_name => '{server}'); end;"
# There is no wait for replication already in progress: pausing is enough.
ACTIVE_BACKUPS_SQL="select count(*) from gv\$session s where s.status = 'ACTIVE' and (lower(s.program) like '%rman%' or lower(s.module) like '%rman%');"
ACTIVE_BACKUPS_LIST_SQL="select 'inst=' || s.inst_id || ' sid=' || s.sid || ',' || s.serial# || '  ' || s.program || '  machine=' || s.machine || '  event=' || s.event || '  wait=' || s.seconds_in_wait || 's' from gv\$session s where s.status = 'ACTIVE' and (lower(s.program) like '%rman%' or lower(s.module) like '%rman%') order by s.inst_id, s.sid;"

QUIESCE_POLL_SECONDS=60
QUIESCE_TIMEOUT_MINUTES=120          # stop before patching if still busy after this long
QUIESCE_WAIT_FOR_BACKUPS=1           # 0 = never wait for incoming backups (or use --skip-backup-wait)
QUIESCE_ALLOW_UNCONFIGURED=0

# verify (the last phase; the jump server runs it after resuming the OEM jobs and
# ending the blackout): new backups, and replication if this run paused it, must
# arrive. Each query prints one number. {since} becomes
# to_date('<time>', 'YYYY-MM-DD HH24:MI:SS'): when the resume phase ran. Nothing
# arriving within VERIFY_TIMEOUT_MINUTES is a warning only. An empty query is not
# checked (a warning).
# TODO(site): fill in both queries.
VERIFY_BACKUPS_SQL=""                # backups received since {since}
VERIFY_REPLICATION_SQL=""            # replication completed since {since}
VERIFY_POLL_SECONDS=300
VERIFY_TIMEOUT_MINUTES=210           # archivelog backups run every 3 hours
