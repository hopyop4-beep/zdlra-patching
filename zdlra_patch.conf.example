# Copy to zdlra_patch.conf and edit. This file is sourced by bash.
# Do not commit your real zdlra_patch.conf (it is in .gitignore).

RACLI="/opt/oracle.RecoveryAppliance/bin/racli"

# "patch" for a bundle patch, "upgrade" for a release upgrade
PATCH_ACTION="patch"

# Record that staging/zdlra_stage.sh writes once the patches and the precheck are
# in place. The precheck phase stops if it is missing, and the approval covers the
# archive it names. It is written in the unzipped folder, /radump/patches.
STAGED_RECORD="/radump/patches/ZDLRA_STAGED.txt"

WORK_DIR="/radump/zdlra_patch_runs"
MIN_FREE_GB=50                       # free space needed in WORK_DIR's filesystem
REQUIRED_USER="root"

# External precheck script (download it yourself; it is not part of this repo).
# Failures are read from the summary at the end of its output:
#   FAILURE SUMMARY
#   ***********************************
#   <date> [FAIL] <failure name>
#   <date> [WARN] <warning name>
# The phase fails on any failure that is not waived, on a timeout, or on a
# non-zero exit code with no summary. Warnings are logged but do not stop the
# run unless PRECHECK_FAIL_ON_WARN=1.
# Oracle's precheck, run as ./precheck -srnumber=<SR> from its own folder.
# In PRECHECK_ARGS, {sr_number} is SR_NUMBER= from the conf file staging set up
# (/radump/patches/conf/patch.conf_<SR>), and {patch_conf} is that file's path.
PRECHECK_SCRIPT="/radump/patches/bin/precheck"
PRECHECK_ARGS=(-srnumber={sr_number})
PRECHECK_CWD=""                      # empty = run from the script's own folder
# Added for the actual patching event (a run with --execute), not for dry runs:
PRECHECK_EVENT_ARGS=(-recheck_all)
PRECHECK_TIMEOUT=3600
PRECHECK_SUMMARY_HEADER="FAILURE SUMMARY"
PRECHECK_FAIL_PATTERN='\[FAIL\]'
PRECHECK_WARN_PATTERN='\[WARN\]'
PRECHECK_FAIL_ON_WARN=0              # 1 = warnings stop the run too (waivers apply)
# Known, accepted failures. Each entry matches part of a failure name.
# Waived failures are logged as warnings and do not stop the run.
PRECHECK_WAIVERS=(
#   "failure name you have reviewed and accepted"
)
PRECHECK_REQUIRED=1

# After the precheck, the operator must type APPROVE. --yes does not skip this.
# patch1/patch2 refuse to run without an approval for the same run that is
# younger than PRECHECK_APPROVAL_MAX_AGE_HOURS and matches the results reviewed.
PRECHECK_REQUIRE_APPROVAL=1
PRECHECK_APPROVAL_MAX_AGE_HOURS=24
POSTCHECK_RERUN_PRECHECK=1

# --- Storage cells (cells phase) --------------------------------------------
# Runs from the first compute node in the folder the cell patch (FILES_CELL) unzipped
# to under /radump/patches/tmp; the folder's name is read from the zip.
CELL_GROUP_FILE="/root/cell_group"
CELL_PREP_STEPS=(-patch_check_prereq -reset_force -cleanup)   # before -patch, in order
CELL_PATCH_EXTRA_ARGS=()             # e.g. (-ignore_alerts); TODO(site): check whether -ignore_alerts is always needed
# patchmgr runs in a session of its own and is never stopped by the script (an
# interrupted patchmgr session can cause major problems). Past this long, the script
# only logs a warning and keeps waiting.
CELL_PATCH_WARN_MINUTES=360          # per patchmgr command; about 2 hours for 17 cells

# --- Replication and incoming backups (quiesce / resume phases) -------------
# SQL runs with sqlplus as the raadmin account. Use a connect string that needs no
# password in this file, such as an Oracle wallet alias.
SQLPLUS="sqlplus"
RA_SQL_CONNECT=""                    # TODO(site): e.g. "/@raadmin"

# While any of these is empty, quiesce is skipped in a dry run and a real run stops
# before patching (unless QUIESCE_ALLOW_UNCONFIGURED=1).
#   REPLICATION_SERVERS_SQL  prints the replication to pause, one remote_ra_dbname per
#                            line: running servers whose role is upstream or paired
#   REPLICATION_STATUS_SQL   shown in the precheck review (read only): every server
#                            with its state and role
#   REPLICATION_PAUSE_SQL    statement run for each of them; {server} is the name
#   REPLICATION_RESUME_SQL   statement run for each one this run paused
#   ACTIVE_REPLICATION_SQL   prints one number: replication still in flight
#   ACTIVE_BACKUPS_SQL       prints one number: incoming backups still running
REPLICATION_SERVERS_SQL="select remote_ra_dbname from ra_replication_pair where upper(replication_server_state) = 'RUNNING' and upper(replication_server_role) in ('UPSTREAM','PAIRED');"
REPLICATION_STATUS_SQL="select remote_ra_dbname || '  state=' || replication_server_state || '  role=' || replication_server_role from ra_replication_pair;"
# Pause/resume each one by its remote_ra_dbname.
REPLICATION_PAUSE_SQL="begin dbms_ra.pause_replication_server(replication_server_name => '{server}'); end;"
REPLICATION_RESUME_SQL="begin dbms_ra.resume_replication_server(replication_server_name => '{server}'); end;"
# TODO(site): the two count queries.
ACTIVE_REPLICATION_SQL=""
ACTIVE_BACKUPS_SQL=""

QUIESCE_POLL_SECONDS=60
QUIESCE_TIMEOUT_MINUTES=120          # stop before patching if still busy after this long
QUIESCE_WAIT_FOR_BACKUPS=1           # 0 = never wait for incoming backups (or use --skip-backup-wait)
QUIESCE_ALLOW_UNCONFIGURED=0
